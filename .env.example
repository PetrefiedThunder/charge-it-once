# Charge it once — environment variables (names only, never real values)

# PayPal Sandbox app credentials, from developer.paypal.com
# (Apps & Credentials -> Sandbox). Required for the PayPal leg.
PAYPAL_SANDBOX_CLIENT_ID=
PAYPAL_SANDBOX_SECRET=

# Optional: PayPal API base. Defaults to https://api-m.sandbox.paypal.com
PAYPAL_SANDBOX_BASE=

# Agent Middleware gateway. Defaults to the staging gateway.
AMW_BASE_URL=

# Agent Middleware API key: set the key value directly (hosting), OR
# point at a chmod-600 file that contains it (local runs). Never commit
# either one.
AMW_API_KEY=
AMW_API_KEY_FILE=

# Demo allocation on the staging gateway (defaults shown in README).
AMW_WALLET_ID=
AMW_PERMIT_ID=

# Server. Hosts usually provide PORT and expect HOST=0.0.0.0.
HOST=
PORT=

# Where run records are stored as JSON. Defaults to ./data
DATA_DIR=
